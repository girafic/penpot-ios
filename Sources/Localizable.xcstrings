    "Deleted files can be restored here for a limited time." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن استعادة الملفات المحذوفة من هنا لفترة محدودة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els fitxers eliminats es poden restaurar aquí durant un temps limitat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazané soubory zde lze po omezenou dobu obnovit."
