    "Removes downloaded thumbnails and avatars from this device. They re-download when needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل الصور المصغّرة والصور الرمزية التي تم تنزيلها من هذا الجهاز. يُعاد تنزيلها عند الحاجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina d’aquest dispositiu les miniatures i els avatars baixats. Es tornen a baixar quan cal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstraní stažené náhledy a avatary z tohoto zařízení. V případě potřeby se znovu stáhnou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt heruntergeladene Vorschaubilder und Avatare von diesem Gerät. Diese werden bei Bedarf erneut geladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αφαιρεί από αυτή τη συσκευή τις μικρογραφίες και τις εικόνες προφίλ που έχουν ληφθεί. Θα ληφθούν ξανά όταν χρειαστεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina de este dispositivo las miniaturas y los avatares descargados. Se vuelven a descargar cuando se necesitan."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deskargatutako miniaturak eta abatarrak gailu honetatik kentzen ditu. Behar direnean berriro deskargatzen dira."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصاویر بندانگشتی و آواتارهای دانلودشده را از این دستگاه حذف می‌کند. در صورت نیاز دوباره دانلود می‌شوند."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strikar heintaðar smámyndir og avatarar á hesum tólinum. Tey verða heintað aftur, tá ið tørvur er á."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime de cet appareil les miniatures et avatars téléchargés. Ils sont retéléchargés au besoin."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime de cet appareil les miniatures et avatars téléchargés. Ils seront téléchargés de nouveau au besoin."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina deste dispositivo as miniaturas e os avatares descargados. Volven descargarse cando se necesitan."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yana cire ƙananan hotuna da avatars da aka sauke daga wannan na'urar. Za a sake sauke su idan ana buƙata."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסיר מהמכשיר הזה תמונות ממוזערות ותמונות פרופיל שהורדו. הן יורדו שוב בעת הצורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस से डाउनलोड किए गए थंबनेल और अवतार हटाता है। ज़रूरत पड़ने पर ये फिर से डाउनलोड हो जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja preuzete minijature i avatare s ovog uređaja. Po potrebi se ponovno preuzimaju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus gambar mini dan avatar yang diunduh dari perangkat ini. Semuanya akan diunduh ulang saat diperlukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le miniature e gli avatar scaricati da questo dispositivo. Verranno scaricati di nuovo quando necessario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードしたサムネイルとアバターをこのデバイスから削除します。必要に応じて再ダウンロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 다운로드한 썸네일과 아바타를 삭제합니다. 필요할 때 다시 다운로드됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noņem no šīs ierīces lejupielādētos sīktēlus un profila attēlus. Vajadzības gadījumā tie tiks lejupielādēti atkal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner nedlastede miniatyrbilder og avatarer fra denne enheten. De lastes ned på nytt ved behov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert gedownloade miniaturen en avatars van dit apparaat. Ze worden opnieuw gedownload wanneer dat nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa pobrane miniatury i awatary z tego urządzenia. W razie potrzeby zostaną pobrane ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove miniaturas e avatares baixados deste dispositivo. Eles são baixados novamente quando necessário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove as miniaturas e os avatares transferidos deste dispositivo. Voltam a ser transferidos quando necessário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină de pe acest dispozitiv miniaturile și avatarele descărcate. Se descarcă din nou când este nevoie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет загруженные миниатюры и аватары с этого устройства. При необходимости они загрузятся снова."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уклања преузете сличице и аватаре са овог уређаја. Поново ће се преузети по потреби."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İndirilen küçük resimleri ve avatarları bu cihazdan kaldırır. Gerektiğinde yeniden indirilirler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє завантажені мініатюри й аватари з цього пристрою. За потреби їх буде завантажено знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此设备中移除已下载的缩略图和头像。需要时会重新下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從此裝置移除已下載的縮圖和大頭貼。需要時會重新下載。"
          }
        }
      }
