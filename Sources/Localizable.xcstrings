    "We can't send email to this address. Contact your server admin." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكننا إرسال بريد إلكتروني إلى هذا العنوان. تواصل مع مشرف الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podem enviar correus a aquesta adreça. Contacteu amb l’administrador del servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tuto adresu nemůžeme posílat e-maily. Kontaktujte správce serveru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir können an diese Adresse keine E-Mails senden. Wenden Sie sich an Ihren Server-Admin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορούμε να στείλουμε email σε αυτή τη διεύθυνση. Επικοινωνήστε με τον διαχειριστή του διακομιστή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No podemos enviar correos a esta dirección. Contacta con el administrador del servidor."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezin dugu epostarik bidali helbide honetara. Jarri harremanetan zerbitzariaren administratzailearekin."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمی‌توانیم به این نشانی ایمیل بفرستیم. با مدیر سرور خود تماس بگیرید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vit kunnu ikki senda teldupost til hesa adressuna. Set teg í samband við umsitaran av ambætaranum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’envoyer un e-mail à cette adresse. Contactez l’administrateur du serveur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’envoyer un courriel à cette adresse. Contactez l’administrateur du serveur."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non podemos enviar correos a este enderezo. Contacta coa administración do servidor."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba za mu iya aika imel zuwa wannan adireshin ba. Tuntuɓi shugaban sabarka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין לנו אפשרות לשלוח דוא״ל לכתובת הזאת. נא לפנות למנהל השרת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम इस पते पर ईमेल नहीं भेज सकते। अपने सर्वर प्रशासक से संपर्क करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne možemo slati e-mailove na ovu adresu. Obrati se administratoru poslužitelja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat mengirim surel ke alamat ini. Hubungi admin server Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non possiamo inviare e-mail a questo indirizzo. Contatta l'amministratore del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアドレスにメールを送信できません。サーバー管理者にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 주소로 이메일을 보낼 수 없습니다. 서버 관리자에게 문의하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uz šo adresi nevar nosūtīt e-pastu. Jāsazinās ar servera administratoru."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
