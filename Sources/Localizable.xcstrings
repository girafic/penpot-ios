    "Penpot will email a confirmation link to the new address. The change takes effect once you open that link." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيرسل Penpot رابط تأكيد إلى العنوان الجديد. يسري التغيير بمجرد فتح ذلك الرابط."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Penpot enviarà un enllaç de confirmació a l’adreça nova. El canvi tindrà efecte quan obriu aquest enllaç."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot pošle na novou adresu potvrzovací odkaz. Změna se projeví, jakmile odkaz otevřete."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot sendet einen Bestätigungslink an die neue Adresse. Die Änderung wird wirksam, sobald Sie den Link öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Penpot θα στείλει έναν σύνδεσμο επιβεβαίωσης στη νέα διεύθυνση. Η αλλαγή θα ισχύσει μόλις ανοίξετε αυτόν τον σύνδεσμο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
