        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iestata šīs lietotnes valodu, izmaiņas stājas spēkā uzreiz. Lai mainītu Penpot tīmekļvietnes un e-pasta valodu, jāizmanto Profils › Konta valoda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
