        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot یک لینک تأیید به نشانی جدید ایمیل می‌کند. تغییر پس از باز کردن آن لینک اعمال می‌شود."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
