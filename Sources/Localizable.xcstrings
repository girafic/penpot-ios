        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A renderização WebGL precisou de mais memória do que este dispositivo permite, por isso a tela passou para a renderização padrão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Randarea WebGL a avut nevoie de mai multă memorie decât permite acest dispozitiv, așa că canvasul a trecut la randarea standard."
