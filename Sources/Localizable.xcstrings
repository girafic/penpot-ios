    "WebGL rendering needed more memory than this device allows, so the canvas switched to standard rendering." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتاج العرض عبر WebGL إلى ذاكرة أكثر مما يسمح به هذا الجهاز، لذا انتقلت اللوحة القماشية إلى العرض القياسي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El renderatge WebGL necessitava més memòria de la que permet aquest dispositiu, així que el llenç ha passat al renderatge estàndard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vykreslování WebGL potřebovalo víc paměti, než toto zařízení povoluje, proto plátno přešlo na standardní vykreslování."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das WebGL-Rendering brauchte mehr Speicher, als dieses Gerät erlaubt. Der Canvas nutzt deshalb das Standard-Rendering."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το rendering WebGL χρειαζόταν περισσότερη μνήμη από όση επιτρέπει αυτή η συσκευή, γι’ αυτό ο καμβάς πέρασε σε τυπικό rendering."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El renderizado WebGL necesitaba más memoria de la que permite este dispositivo, así que el lienzo ha cambiado al renderizado estándar."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL errendatzeak gailu honek baimentzen duena baino memoria gehiago behar zuen; beraz, mihisea errendatze estandarrera aldatu da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رندر WebGL به حافظه‌ای بیش از آنچه این دستگاه اجازه می‌دهد نیاز داشت، بنابراین بوم به رندر استاندارد تغییر کرد."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL-tekningin tørvaði meira minni, enn hendan eindin loyvir, so lørift skifti til vanliga tekning."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu WebGL nécessitait plus de mémoire que cet appareil ne le permet. Le canevas utilise donc le rendu standard."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rendu WebGL nécessitait plus de mémoire que cet appareil ne le permet. Le canevas utilise donc le rendu standard."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O renderizado WebGL necesitaba máis memoria da que permite este dispositivo, así que o lenzo pasou ao renderizado estándar."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanen WebGL ya buƙaci ƙarin ƙwaƙwalwa fiye da yadda wannan na'urar ta yarda, don haka zanen ya koma zane na yau da kullum."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תיצוג עם WebGL דרש יותר זיכרון ממה שהמכשיר הזה מאפשר, ולכן משטח הציור עבר לתיצוג רגיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL रेंडरिंग को इस डिवाइस की अनुमति से अधिक मेमोरी चाहिए थी, इसलिए कैनवास मानक रेंडरिंग पर चला गया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL iscrtavanju trebalo je više memorije nego što ovaj uređaj dopušta, pa je platno prešlo na standardno iscrtavanje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendering WebGL memerlukan memori lebih besar daripada yang diizinkan perangkat ini, jadi kanvas beralih ke rendering standar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il rendering WebGL richiedeva più memoria di quella consentita da questo dispositivo, quindi il canvas è passato al rendering standard."
