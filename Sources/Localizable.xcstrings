    "“%@” will become the owner of this team. You will become an admin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيصبح «%@» مالك هذا الفريق. وستصبح أنت مشرفًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» passarà a ser el propietari d’aquest equip. Passareu a ser administrador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ se stane majitelem tohoto týmu. Vy se stanete správcem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird Eigentümer dieses Teams. Sie werden Admin."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χρήστης «%@» θα γίνει ιδιοκτήτης αυτής της ομάδας. Εσείς θα γίνετε διαχειριστής."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» tendrá la propiedad de este equipo. Tu rol cambiará a Administración."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» talde honen jabea izango da. Zure rola Kudeatzaile izatera pasatuko da."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» مالک این تیم خواهد شد. نقش شما به مدیر تغییر می‌کند."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verður eigari av hesum toyminum. Tú verður umsitari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » deviendra propriétaire de cette équipe. Vous deviendrez administrateur."
