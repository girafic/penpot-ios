          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se importó «%@». Abre el proyecto para verla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été importé. Ouvrez le projet pour le voir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
