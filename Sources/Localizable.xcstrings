    "A new photo may take a moment to appear elsewhere in the app." : {
      "comment" : "A footer for the avatar section of the profile settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Foto kann einen Moment brauchen, bis es überall in der App erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nueva foto puede tardar un momento en aparecer en el resto de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle photo peut mettre un instant à apparaître ailleurs dans l’application."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova foto pode levar um momento para aparecer em outras partes do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое фото может появиться в других частях приложения не сразу."
          }
        }
      }
    },
