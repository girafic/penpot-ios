    "Verify your email address first — check your inbox for the registration email." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من عنوان بريدك الإلكتروني أولًا — ابحث في بريدك الوارد عن رسالة التسجيل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primer verifiqueu la vostra adreça de correu — cerqueu el correu de registre a la safata d’entrada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejprve ověřte svou e-mailovou adresu — vyhledejte v doručené poště registrační e-mail."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigen Sie zuerst Ihre E-Mail-Adresse – suchen Sie in Ihrem Posteingang nach der Registrierungs-E-Mail."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επαληθεύστε πρώτα τη διεύθυνση email σας — αναζητήστε το email εγγραφής στα εισερχόμενά σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica primero tu dirección de correo: busca el correo de registro."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egiaztatu lehenik zure eposta helbidea — begiratu sarrera-ontzian erregistro-mezua."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابتدا نشانی ایمیل خود را تأیید کنید — ایمیل ثبت‌نام را در صندوق ورودی خود پیدا کنید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vátta fyrst tína teldupostadressu — hygg í postkassan eftir skrásetingarteldupostinum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez d’abord votre adresse e-mail — cherchez l’e-mail d’inscription dans votre boîte de réception."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez d’abord votre adresse courriel — cherchez le courriel d’inscription dans votre boîte de réception."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica primeiro o teu enderezo de correo electrónico: busca o correo de rexistro na túa caixa de entrada."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fara tabbatar da adireshin imel ɗinka — duba akwatin saƙonka don imel ɗin rajista."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לאמת קודם את כתובת הדוא״ל — הודעת ההרשמה מחכה בתיבת הדואר הנכנס."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले अपना ईमेल पता सत्यापित करें — पंजीकरण ईमेल के लिए अपना इनबॉक्स देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najprije potvrdi svoju e-mail adresu — potraži e-mail za registraciju u pristigloj pošti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifikasi alamat surel Anda terlebih dahulu — periksa kotak masuk untuk surel pendaftaran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica prima il tuo indirizzo e-mail — cerca l'e-mail di registrazione nella posta in arrivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずメールアドレスを確認してください。受信トレイに届いた登録メールをご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 이메일 주소를 인증하세요 — 받은편지함에서 가입 이메일을 확인하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
