          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filens nåværende innhold erstattes av denne versjonen. Penpot lagrer først en automatisk sikkerhetskopi av den nåværende tilstanden, slik at du kan gjenopprette den fra denne listen."
