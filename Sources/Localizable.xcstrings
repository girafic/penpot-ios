            "value" : "Vispirms jāapstiprina e-pasta adrese — reģistrācijas e-pasts jāmeklē iesūtnē."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekreft e-postadressen din først – se etter registreringse-posten i innboksen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifieer eerst je e-mailadres – zoek in je inbox naar de registratie-e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw potwierdź adres email — poszukaj w skrzynce wiadomości rejestracyjnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique primeiro seu e-mail — procure o e-mail de cadastro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
