    "This can’t be undone. Your account, subscription and organizations will be deleted immediately, and you’ll lose access to your projects and files." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن ذلك. سيتم حذف حسابك واشتراكك ومؤسساتك فورًا، وستفقد الوصول إلى مشاريعك وملفاتك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta acció no es pot desfer. El vostre compte, la subscripció i les organitzacions s’eliminaran immediatament i perdreu l’accés als vostres projectes i fitxers."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuto akci nelze vrátit zpět. Váš účet, předplatné a organizace budou okamžitě smazány a ztratíte přístup ke svým projektům a souborům."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies kann nicht rückgängig gemacht werden. Ihr Konto, Ihr Abonnement und Ihre Organisationen werden sofort gelöscht, und Sie verlieren den Zugriff auf Ihre Projekte und Dateien."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ενέργεια δεν αναιρείται. Ο λογαριασμός, η συνδρομή και οι οργανισμοί σας θα διαγραφούν αμέσως και θα χάσετε την πρόσβαση στα έργα και τα αρχεία σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede deshacer. Tu cuenta, tu suscripción y tus organizaciones se eliminarán de inmediato y perderás el acceso a tus proyectos y archivos."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezin da desegin. Zure kontua, harpidetza eta erakundeak berehala ezabatuko dira, eta zure proiektu eta fitxategietarako sarbidea galduko duzu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار برگشت‌پذیر نیست. حساب کاربری، اشتراک و سازمان‌های شما فوراً حذف می‌شوند و دسترسی خود را به پروژه‌ها و فایل‌هایتان از دست می‌دهید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hetta kann ikki angrast. Konto tín, haldið og felagsskapir tínir verða strikað beinanvegin, og tú missir atgongdina til verkætlanir og fílur tínar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible. Votre compte, votre abonnement et vos organisations seront supprimés immédiatement, et vous perdrez l’accès à vos projets et fichiers."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible. Votre compte, votre abonnement et vos organisations seront supprimés immédiatement, et vous perdrez l’accès à vos projets et fichiers."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non se pode desfacer. A túa conta, a túa subscrición e as túas organizacións eliminaranse de inmediato e perderás o acceso aos teus proxectos e ficheiros."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba za a iya dawo da wannan ba. Za a goge asusunka, biyan kuɗinka da ƙungiyoyinka nan take, kuma za ka rasa damar shiga ayyukanka da kundayenka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר לבטל את הפעולה הזאת. החשבון, המינוי והארגונים שלך יימחקו מיד, והגישה שלך למיזמים ולקבצים שלך תאבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे पूर्ववत नहीं किया जा सकता। आपका खाता, सदस्यता और संगठन तुरंत हटा दिए जाएँगे, और आप अपने प्रोजेक्ट और फ़ाइलों तक पहुँच खो देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To se ne može poništiti. Tvoj račun, pretplata i organizacije odmah će se izbrisati, a ti ćeš izgubiti pristup svojim projektima i datotekama."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini tidak dapat dibatalkan. Akun, langganan, dan organisasi Anda akan segera dihapus, dan Anda akan kehilangan akses ke proyek dan berkas Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa azione è irreversibile. Il tuo account, l'abbonamento e le organizzazioni verranno eliminati immediatamente e perderai l'accesso ai tuoi progetti e file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。アカウント、サブスクリプション、組織はただちに削除され、プロジェクトとファイルにアクセスできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 되돌릴 수 없습니다. 계정, 구독 및 조직이 즉시 삭제되며 프로젝트와 파일에 더 이상 액세스할 수 없게 됩니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nevar atsaukt. Konts, abonements un organizācijas tiks nekavējoties izdzēsti, un tiks zaudēta piekļuve projektiem un datnēm."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan ikke angres. Kontoen, abonnementet og organisasjonene dine slettes umiddelbart, og du mister tilgangen til prosjektene og filene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan niet ongedaan worden gemaakt. Je account, abonnement en organisaties worden onmiddellijk verwijderd en je verliest de toegang tot je projecten en bestanden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tej operacji nie można cofnąć. Twoje konto, subskrypcja i organizacje zostaną natychmiast usunięte, a Ty stracisz dostęp do swoich projektów i plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser desfeito. Sua conta, sua assinatura e suas organizações serão excluídas imediatamente, e você perderá o acesso aos seus projetos e arquivos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta ação não pode ser anulada. A tua conta, subscrição e organizações serão eliminadas imediatamente e perderás o acesso aos teus projetos e ficheiros."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acțiunea nu poate fi anulată. Contul, abonamentul și organizațiile tale vor fi șterse imediat și vei pierde accesul la proiectele și fișierele tale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это действие необратимо. Ваш аккаунт, подписка и организации будут удалены сразу, и вы потеряете доступ к своим проектам и файлам."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ово се не може опозвати. Ваш налог, претплата и организације биће одмах избрисани и изгубићете приступ својим пројектима и датотекама."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem geri alınamaz. Hesabınız, aboneliğiniz ve organizasyonlarınız hemen silinecek ve projelerinize ve dosyalarınıza erişiminizi kaybedeceksiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цю дію не можна скасувати. Ваш обліковий запис, підписку й організації буде видалено негайно, і ви втратите доступ до своїх проєктів і файлів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。你的账号、订阅和组织将被立即删除，你将无法再访问你的项目和文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作無法復原。你的帳號、訂閱和組織將立即被刪除，你將無法再存取你的專案和檔案。"
          }
        }
      }
    },
