            "state" : "translated",
            "value" : "Utilitzeu com a mínim 8 caràcters, amb una majúscula, una minúscula, un número i un caràcter especial."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte alespoň 8 znaků včetně velkého písmene, malého písmene, číslice a speciálního znaku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie mindestens 8 Zeichen, darunter einen Großbuchstaben, einen Kleinbuchstaben, eine Zahl und ein Sonderzeichen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε τουλάχιστον 8 χαρακτήρες, μεταξύ των οποίων ένα κεφαλαίο γράμμα, ένα πεζό γράμμα, έναν αριθμό και έναν ειδικό χαρακτήρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa al menos 8 caracteres, incluidas una mayúscula, una minúscula, un número y un carácter especial."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erabili gutxienez 8 karaktere, tartean letra larri bat, letra xehe bat, zenbaki bat eta karaktere berezi bat."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حداقل از 8 حرف استفاده کنید، شامل یک حرف بزرگ، یک حرف کوچک، یک عدد و یک نماد خاص."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brúka minst 8 stavir, harímillum ein stóran bókstav, ein lítlan bókstav, eitt tal og eitt sertekn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez au moins 8 caractères, dont une majuscule, une minuscule, un chiffre et un caractère spécial."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez au moins 8 caractères, dont une majuscule, une minuscule, un chiffre et un caractère spécial."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa polo menos 8 caracteres, incluídas unha maiúscula, unha minúscula, un número e un carácter especial."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yi amfani da aƙalla alamomi 8, ciki har da babban harafi, ƙaramin harafi, lamba da alama ta musamman."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להשתמש ב־8 תווים לפחות, כולל אות גדולה, אות קטנה, ספרה ותו מיוחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम से कम 8 अक्षरों का उपयोग करें, जिनमें एक बड़ा अक्षर, एक छोटा अक्षर, एक संख्या और एक विशेष चिह्न शामिल हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi najmanje 8 znakova, uključujući veliko slovo, malo slovo, broj i poseban znak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan setidaknya 8 karakter, termasuk huruf besar, huruf kecil, angka, dan karakter khusus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa almeno 8 caratteri, tra cui una lettera maiuscola, una minuscola, un numero e un carattere speciale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大文字、小文字、数字、記号をそれぞれ1つ以上含む、8文字以上のパスワードを使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대문자, 소문자, 숫자, 특수 문자를 각각 하나 이상 포함하여 8자 이상 입력하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jāizmanto vismaz 8 rakstzīmes, tostarp lielais burts, mazais burts, cipars un speciālā rakstzīme."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk minst 8 tegn, inkludert en stor bokstav, en liten bokstav, et tall og et spesialtegn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik minimaal 8 tekens, waaronder een hoofdletter, een kleine letter, een cijfer en een speciaal teken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj co najmniej 8 znaków, w tym wielkiej litery, małej litery, cyfry i znaku specjalnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use pelo menos 8 caracteres, incluindo uma letra maiúscula, uma minúscula, um número e um caractere especial."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa pelo menos 8 caracteres, incluindo uma letra maiúscula, uma letra minúscula, um número e um caráter especial."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește cel puțin 8 caractere, inclusiv o literă mare, o literă mică, o cifră și un caracter special."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте не менее 8 символов, включая заглавную и строчную буквы, цифру и специальный символ."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користите најмање 8 знакова, укључујући велико слово, мало слово, број и специјални знак."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir büyük harf, bir küçük harf, bir rakam ve bir özel karakter içeren en az 8 karakter kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте щонайменше 8 символів, зокрема велику й малу літери, цифру та спеціальний символ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用至少 8 个字符，包括大写字母、小写字母、数字和特殊字符。"
          }
        },
        "zh-Hant" : {
