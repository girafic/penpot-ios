    "“%@” and all its variants will be removed." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und alle zugehörigen Varianten werden entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y todas sus variantes se eliminarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et toutes ses variantes seront supprimés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e todas as suas variantes serão removidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и все его варианты будут удалены."
          }
        }
      }
    },
    "“%@” and all of its projects and files will be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird mit allen zugehörigen Projekten und Dateien gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» se eliminará junto con todos sus proyectos y archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimée avec tous ses projets et fichiers."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” será excluída com todos os seus projetos e arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» будет удалена вместе со всеми её проектами и файлами."
          }
        }
      }
    },
    "“%@” was imported. Open the project to view it." : {
      "comment" : "Confirmation after importing a template. %@ is the template name.",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde importiert. Öffne das Projekt, um sie anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se importó «%@». Abre el proyecto para verla."
          }
        },
