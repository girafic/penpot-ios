    "We sent a confirmation link to %@. Open it to finish changing your email." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسلنا رابط تأكيد إلى %@. افتحه لإكمال تغيير بريدك الإلكتروني."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hem enviat un enllaç de confirmació a %@. Obriu-lo per acabar de canviar el correu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na adresu %@ jsme poslali potvrzovací odkaz. Otevřete ho a dokončete změnu e-mailu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben einen Bestätigungslink an %@ gesendet. Öffnen Sie ihn, um die Änderung Ihrer E-Mail-Adresse abzuschließen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στείλαμε έναν σύνδεσμο επιβεβαίωσης στο %@. Ανοίξτε τον για να ολοκληρώσετε την αλλαγή του email σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos un enlace de confirmación a %@. Ábrelo para terminar de cambiar tu correo."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berrespen-esteka bat bidali dugu %@ helbidera. Ireki ezazu zure eposta aldatzen amaitzeko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک لینک تأیید به %@ فرستادیم. برای تکمیل تغییر ایمیل، آن را باز کنید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vit sendu eitt váttanarleinki til %@. Lat tað upp fyri at fullfíggja broytingina av teldupostinum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons envoyé un lien de confirmation à %@. Ouvrez-le pour finaliser le changement d’e-mail."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons envoyé un lien de confirmation à %@. Ouvrez-le pour terminer le changement d’adresse courriel."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos unha ligazón de confirmación a %@. Ábrea para rematar o cambio do teu correo electrónico."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mun aika hanyar tabbatarwa zuwa %@. Buɗe ta don kammala canza imel ɗinka."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלחנו קישור אישור אל %@. יש לפתוח אותו כדי להשלים את החלפת כתובת הדוא״ל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने %@ पर एक पुष्टिकरण लिंक भेजा है। ईमेल बदलना पूरा करने के लिए उसे खोलें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poslali smo poveznicu za potvrdu na %@. Otvori je da dovršiš promjenu e-maila."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami telah mengirim tautan konfirmasi ke %@. Buka tautan tersebut untuk menyelesaikan perubahan surel Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo inviato un link di conferma a %@. Aprilo per completare la modifica dell'e-mail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に確認リンクを送信しました。リンクを開いてメールアドレスの変更を完了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 확인 링크를 보냈습니다. 링크를 열어 이메일 변경을 완료하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apstiprinājuma saite ir nosūtīta uz %@. Lai pabeigtu e-pasta adreses maiņu, tā jāatver."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi har sendt en bekreftelseslenke til %@. Åpne den for å fullføre endringen av e-postadressen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben een bevestigingslink naar %@ gestuurd. Open die om de wijziging van je e-mailadres te voltooien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysłaliśmy link potwierdzający na %@. Otwórz go, aby dokończyć zmianę adresu email."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos um link de confirmação para %@. Abra-o para concluir a alteração do e-mail."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviámos um link de confirmação para %@. Abre-o para concluir a alteração do e-mail."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am trimis un link de confirmare la %@. Deschide-l pentru a finaliza schimbarea adresei de e-mail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы отправили ссылку для подтверждения на %@. Откройте её, чтобы завершить смену эл. почты."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Послали смо везу за потврду на %@. Отворите је да бисте довршили промену е-поште."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ adresine bir onay bağlantısı gönderdik. E-posta değişikliğini tamamlamak için bağlantıyı açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми надіслали посилання для підтвердження на %@. Відкрийте його, щоб завершити зміну електронної пошти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们已向 %@ 发送确认链接。打开该链接即可完成电子邮件更改。"
          }
        },
