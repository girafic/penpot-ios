    "You own one or more teams with other members. Transfer ownership or remove those members in Penpot, then try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du besitzt ein oder mehrere Teams mit weiteren Mitgliedern. Übertrage die Eigentümerschaft oder entferne diese Mitglieder in Penpot und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres propietario de uno o más equipos con otros miembros. Transfiere la propiedad o elimina a esos miembros en Penpot y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous possédez une ou plusieurs équipes comptant d’autres membres. Transférez la propriété ou retirez ces membres dans Penpot, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é proprietário de uma ou mais equipes com outros membros. Transfira a propriedade ou remova esses membros no Penpot e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы владеете одной или несколькими командами с другими участниками. Передайте право владения или удалите этих участников в Penpot и повторите попытку."
          }
        }
      }
    },
