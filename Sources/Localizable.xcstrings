    "The file's current content will be replaced by this version. Penpot saves an automatic backup of the current state first, so you can restore it from this list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُستبدل المحتوى الحالي للملف بهذا الإصدار. يحفظ Penpot أولًا نسخة احتياطية تلقائية من الحالة الحالية، لذا يمكنك استعادتها من هذه القائمة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contingut actual del fitxer se substituirà per aquesta versió. Abans, el Penpot desa una còpia de seguretat automàtica de l’estat actual, que podreu restaurar des d’aquesta llista."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální obsah souboru bude nahrazen touto verzí. Penpot nejprve automaticky zálohuje aktuální stav, takže ho můžete obnovit z tohoto seznamu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
