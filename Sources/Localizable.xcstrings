    "New comments on your team's files show up here." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا التعليقات الجديدة على ملفات فريقك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
