    "Penpot is temporarily unavailable due to a system issue. Please try again shortly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot غير متاح مؤقتًا بسبب مشكلة في النظام. يُرجى المحاولة مرة أخرى بعد قليل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Penpot no està disponible temporalment per un problema del sistema. Torneu-ho a provar d'aquí a una estona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot je dočasně nedostupný kvůli systémové chybě. Zkuste to prosím za chvíli znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot ist aufgrund eines Systemproblems vorübergehend nicht verfügbar. Bitte versuchen Sie es in Kürze erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Penpot δεν είναι προσωρινά διαθέσιμο λόγω προβλήματος συστήματος. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot no está disponible temporalmente debido a un problema del sistema. Por favor, inténtalo de nuevo en unos momentos."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot ez dago erabilgarri aldi baterako, sistemako arazo baten ondorioz. Saiatu berriro laster."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot به‌دلیل مشکل سیستمی موقتاً در دسترس نیست. لطفاً کمی بعد دوباره امتحان کنید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot er fyribils ikki tøkt vegna ein kervistrupulleika. Royn aftur um eina løtu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot est temporairement indisponible en raison d'un problème système. Veuillez réessayer sous peu."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot est temporairement indisponible dû à une erreur système. Réessayer plus tard."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot non está dispoñible temporalmente por un problema do sistema. Téntao de novo en breve."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penpot ba ya samuwa na ɗan lokaci saboda matsalar tsarin. Da fatan za a sake gwadawa nan ba da jimawa ba."
