    "You own one or more teams with other members. Transfer ownership or remove those members in Penpot, then try again." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت تملك فريقًا واحدًا أو أكثر يضم أعضاء آخرين. انقل الملكية أو أزل هؤلاء الأعضاء في Penpot، ثم حاول مرة أخرى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sou propietari d’un o més equips amb altres membres. Ascendiu un altre membre a propietari o elimineu aquests membres al Penpot i torneu-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlastníte jeden nebo více týmů s dalšími členy. Převeďte vlastnictví nebo tyto členy odeberte v aplikaci Penpot a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind Eigentümer eines oder mehrerer Teams mit weiteren Mitgliedern. Übertragen Sie die Eigentümerschaft oder entfernen Sie diese Mitglieder in Penpot und versuchen Sie es dann erneut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είστε ιδιοκτήτης μίας ή περισσότερων ομάδων με άλλα μέλη. Μεταβιβάστε την ιδιοκτησία ή αφαιρέστε αυτά τα μέλη στο Penpot και, στη συνέχεια, δοκιμάστε ξανά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes la propiedad de uno o más equipos con otras personas integrantes. Transfiere la propiedad o quita a esas personas en Penpot y vuelve a intentarlo."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste kide batzuk dituzten talde baten edo gehiagoren jabea zara. Eman jabetza edo kendu kide horiek Penpoten, eta saiatu berriro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما مالک یک یا چند تیم با اعضای دیگر هستید. در Penpot مالکیت را منتقل کنید یا آن اعضا را حذف کنید و سپس دوباره تلاش کنید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú eigur eitt ella fleiri toymi við øðrum limum. Flyt eigaraskapið ella tak hesar limirnar burtur í Penpot, og royn so aftur."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes propriétaire d’une ou plusieurs équipes comptant d’autres membres. Promouvez un autre membre comme propriétaire ou supprimez ces membres dans Penpot, puis réessayez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes propriétaire d’une ou de plusieurs équipes comptant d’autres membres. Transférez la propriété ou retirez ces membres dans Penpot, puis réessayez."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes a propiedade dun ou máis equipos con outros integrantes. Transfire a propiedade ou retira eses integrantes en Penpot e téntao de novo."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kana da tawaga ɗaya ko fiye masu wasu mambobi. Canza wurin mallaka ko cire waɗannan mambobi a Penpot, sannan ka sake gwadawa."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לך בעלות על צוות אחד או יותר עם חברים נוספים. יש להעביר את הבעלות או להסיר את החברים האלה ב־Penpot, ואז לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऐसी एक या अधिक टीमों के स्वामी हैं जिनमें अन्य सदस्य हैं। Penpot में स्वामित्व स्थानांतरित करें या उन सदस्यों को हटाएँ, फिर दोबारा प्रयास करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vlasnik si jednog ili više timova s drugim članovima. Prenesi vlasništvo ili ukloni te članove u aplikaciji Penpot, a zatim pokušaj ponovo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda memiliki satu atau beberapa tim dengan anggota lain. Transfer kepemilikan atau keluarkan anggota tersebut di Penpot, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei proprietario di uno o più team con altri membri. Trasferisci la proprietà o rimuovi quei membri in Penpot, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のメンバーがいるチームを1つ以上所有しています。Penpotでオーナー権限を譲渡するか、それらのメンバーを削除してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 구성원이 있는 팀을 하나 이상 소유하고 있습니다. Penpot에서 소유권을 이전하거나 해당 구성원을 제거한 후 다시 시도하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tev pieder viena vai vairākas komandas ar citiem dalībniekiem. Penpot tīmekļvietnē jānodod īpašumtiesības vai jānoņem šie dalībnieki, un pēc tam jāmēģina vēlreiz."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du eier ett eller flere team med andre medlemmer. Overfør eierskapet eller fjern disse medlemmene i Penpot, og prøv deretter igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent eigenaar van een of meer teams met andere leden. Draag het eigendom over of verwijder die leden in Penpot en probeer het dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś właścicielem co najmniej jednego zespołu z innymi członkami. Przekaż własność lub usuń tych członków w Penpot, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você é proprietário de uma ou mais equipes com outros membros. Transfira a propriedade ou remova esses membros no Penpot e tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "És proprietário de uma ou mais equipas com outros membros. Transfere a propriedade ou remove esses membros no Penpot e tenta novamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deții una sau mai multe echipe cu alți membri. Transferă proprietatea sau elimină acei membri în Penpot, apoi încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы владеете одной или несколькими командами с другими участниками. Передайте права владельца или удалите этих участников в Penpot, затем повторите попытку."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поседујете један или више тимова са другим члановима. Пренесите власништво или уклоните те чланове у Penpot-у, па покушајте поново."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka üyeleri olan bir veya daha fazla takımın sahibisiniz. Penpot'ta sahipliği aktarın veya bu üyeleri kaldırın, ardından tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви володієте однією або кількома командами з іншими учасниками. Передайте права власності або вилучіть цих учасників у Penpot, а потім спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你拥有一个或多个包含其他成员的团队。请在 Penpot 中转让所有权或移除这些成员，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你擁有一個或多個包含其他成員的團隊。請在 Penpot 中轉移所有權或移除這些成員，然後再試一次。"
          }
        }
      }
    },
