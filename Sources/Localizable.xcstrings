    "A new photo may take a moment to appear elsewhere in the app." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يستغرق ظهور الصورة الجديدة في أماكن أخرى من التطبيق بعض الوقت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto nova pot trigar una estona a aparèixer a la resta de l’aplicació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová fotka se může v dalších částech aplikace zobrazit až po chvíli."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Foto kann einen Moment brauchen, bis es überall in der App erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια νέα φωτογραφία μπορεί να χρειαστεί λίγο χρόνο για να εμφανιστεί σε όλη την εφαρμογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nueva foto puede tardar un momento en aparecer en el resto de la app."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Argazki berriak denbora pixka bat behar izan dezake aplikazioko beste lekuetan agertzeko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ممکن است کمی طول بکشد تا عکس جدید در بخش‌های دیگر برنامه نمایش داده شود."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein nýggj mynd kann taka eina løtu um at síggjast aðrastaðni í appini."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle photo peut mettre un instant à apparaître ailleurs dans l’application."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle photo peut prendre un moment avant d’apparaître ailleurs dans l’application."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unha foto nova pode tardar un momento en aparecer no resto da app."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabon hoto na iya ɗaukar ɗan lokaci kafin ya bayyana a wasu wurare a cikin manhajar."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ייתכן שיעבור רגע עד שהתמונה החדשה תופיע בשאר האפליקציה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नई फ़ोटो को ऐप में अन्य जगहों पर दिखने में थोड़ा समय लग सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova fotografija može se s odgodom pojaviti u ostatku aplikacije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto baru mungkin perlu beberapa saat untuk muncul di bagian lain aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nuova foto potrebbe impiegare qualche istante per comparire nel resto dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい写真がアプリ内の他の場所に反映されるまで、少し時間がかかる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 사진이 앱의 다른 곳에 표시되기까지 잠시 시간이 걸릴 수 있습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaunais fotoattēls citur lietotnē var parādīties ar nelielu aizkavi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan ta litt tid før et nytt bilde vises andre steder i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het kan even duren voordat een nieuwe foto overal in de app verschijnt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe zdjęcie może pojawić się w innych miejscach aplikacji z opóźnieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova foto pode levar um momento para aparecer em outras partes do app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma nova fotografia pode demorar um pouco a aparecer no resto da app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O fotografie nouă poate apărea cu o mică întârziere în restul aplicației."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новое фото может появиться в других частях приложения не сразу."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нова фотографија се можда неће одмах појавити у другим деловима апликације."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni fotoğrafın uygulamanın diğer bölümlerinde görünmesi biraz zaman alabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нове фото може з'явитися в інших частинах застосунку не одразу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新照片可能需要一点时间才会在应用的其他位置显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新照片可能需要一些時間才會在 App 的其他位置顯示。"
