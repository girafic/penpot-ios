        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL レンダリングにこのデバイスで許可されている以上のメモリが必要だったため、キャンバスを標準レンダリングに切り替えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL 렌더링에 이 기기가 허용하는 것보다 많은 메모리가 필요해서 캔버스를 표준 렌더링으로 전환했습니다."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL renderēšanai vajadzēja vairāk atmiņas, nekā atļauj šī ierīce, tāpēc kanva pārslēdzās uz standarta renderēšanu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebGL-gjengivelsen trengte mer minne enn denne enheten tillater, så lerretet byttet til standard gjengivelse."
