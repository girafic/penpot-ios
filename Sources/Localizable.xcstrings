    "Tokens grant full API access to your account. Delete any you no longer use." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمنح الرموز وصولًا كاملًا إلى حسابك عبر API. احذف أي رمز لم تعد تستخدمه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els tokens donen accés complet a l’API del vostre compte. Elimineu els que ja no utilitzeu."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny poskytují plný přístup k API vašeho účtu. Smažte ty, které už nepoužíváte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens gewähren vollen API-Zugriff auf Ihr Konto. Löschen Sie alle, die Sie nicht mehr verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα token παρέχουν πλήρη πρόσβαση API στον λογαριασμό σας. Διαγράψτε όσα δεν χρησιμοποιείτε πλέον."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tokens otorgan acceso total a la API de tu cuenta. Elimina los que ya no uses."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokenek zure konturako API sarbide osoa ematen dute. Ezabatu erabiltzen ez dituzunak."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توکن‌ها دسترسی کامل API به حساب شما می‌دهند. هر توکنی را که دیگر استفاده نمی‌کنید حذف کنید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekin geva fulla API-atgongd til tína konto. Strika tey, ið tú ikki longur brúkar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tokens donnent un accès complet à l’API de votre compte. Supprimez ceux que vous n’utilisez plus."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tokens donnent un accès complet à l’API de votre compte. Supprimez ceux que vous n’utilisez plus."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tokens outorgan acceso completo á API da túa conta. Elimina os que xa non uses."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens suna ba da cikakkiyar damar API ga asusunka. Goge duk wanda ba ka amfani da shi yanzu."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אסימונים מעניקים גישת API מלאה לחשבון שלך. כדאי למחוק אסימונים שכבר אינם בשימוש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टोकन आपके खाते को पूरा API एक्सेस देते हैं। जिनका आप अब उपयोग नहीं करते, उन्हें हटा दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeni daju potpun API pristup tvom računu. Izbriši one koje više ne koristiš."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token memberikan akses API penuh ke akun Anda. Hapus token yang tidak lagi Anda gunakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I token concedono pieno accesso all'API del tuo account. Elimina quelli che non usi più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンはアカウントへの完全なAPIアクセス権を付与します。使用しなくなったトークンは削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰은 계정에 대한 전체 API 액세스 권한을 부여합니다. 더 이상 사용하지 않는 토큰은 삭제하세요."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marķieri nodrošina pilnu API piekļuvi kontam. Neizmantotos marķierus ieteicams izdzēst."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokener gir full API-tilgang til kontoen din. Slett dem du ikke lenger bruker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens geven volledige API-toegang tot je account. Verwijder tokens die je niet meer gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokeny dają pełny dostęp do Twojego konta przez API. Usuń te, których już nie używasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tokens concedem acesso total à API da sua conta. Exclua os que você não usa mais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os tokens dão acesso total à API da tua conta. Elimina os que já não usas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token-urile oferă acces complet la API pentru contul tău. Șterge-le pe cele pe care nu le mai folosești."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токены дают полный доступ к API вашего аккаунта. Удаляйте те, которые больше не используете."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токени дају пун API приступ вашем налогу. Избришите оне које више не користите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokenler hesabınıza tam API erişimi sağlar. Artık kullanmadıklarınızı silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токени надають повний доступ до API вашого облікового запису. Видаляйте ті, якими більше не користуєтеся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "令牌可完全访问你账号的 API。请删除不再使用的令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權杖可完整存取你帳號的 API。請刪除不再使用的權杖。"
          }
        }
      }
    },
    "Touch and hold a pin to move it" : {
      "localizations" : {
        "ar" : {
