        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De huidige inhoud van het bestand wordt vervangen door deze versie. Penpot maakt eerst automatisch een back-up van de huidige staat, zodat je die vanuit deze lijst kunt herstellen."
