    "Touch and hold with two fingers for 2 seconds to leave full screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس مع الاستمرار بإصبعين لمدة ثانيتين للخروج من ملء الشاشة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premut amb dos dits durant 2 segons per sortir de la pantalla completa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celou obrazovku ukončíte podržením dvou prstů po dobu 2 sekund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten Sie zwei Finger 2 Sekunden lang gedrückt, um das Vollbild zu beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε παρατεταμένα με δύο δάχτυλα για 2 δευτερόλεπτα για έξοδο από την πλήρη οθόνη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado con dos dedos durante 2 segundos para salir de la pantalla completa."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eutsi bi hatzez 2 segundoz pantaila osotik irteteko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای خروج از حالت تمام‌صفحه، با دو انگشت ۲ ثانیه لمس کنید و نگه دارید."
          }
        },
        "fo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halt við tveimum fingrum í 2 sekund fyri at fara úr fullum skermi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez deux doigts appuyés pendant 2 secondes pour quitter le plein écran."
