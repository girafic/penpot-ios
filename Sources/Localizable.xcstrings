        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renderowanie WebGL wymagało więcej pamięci, niż pozwala to urządzenie, dlatego płótno przełączono na renderowanie standardowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
